<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net9.0;net9.0-windows;net9.0-android</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>

        <Title>AWV.WebView.Avalonia</Title>
        <Authors>MartinNovan</Authors>
        <Description>Cross-platform WebView control for Avalonia. Supports Windows, Linux (GTK), and Android.</Description>
        <PackageProjectUrl>https://github.com/MartinNovan/AWV.WebView.Avalonia</PackageProjectUrl>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <RepositoryUrl>https://github.com/MartinNovan/AWV.WebView.Avalonia</RepositoryUrl>
        <Version>2.0.0-preview.1</Version>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageTags>Avalonia;WebView;WebKitGTK;Wayland;WebView2;Android</PackageTags>
        <PackageIcon>Assets/AWV_icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>
            - Added cross-platform navigation API (Back, Forward, Reload, Stop).
            - Added URL allowlist and blocklist support.
            - Added local HTML file support.
            - Improved Linux WebKitGTK rendering and keyboard handling.
            - Improved Android WebView integration.
            - Added cross-platform sample application.
            - Fixed various stability and navigation issues.
        </PackageReleaseNotes>
        <Copyright>Copyright © 2026 Martin Novan</Copyright>
        
    </PropertyGroup>

    <ItemGroup>
        <None Include="Assets/AWV_icon.png" Pack="true" PackagePath="Assets/" />
        <None Include="Assets/README.md" Pack="true" PackagePath="/" Link="README.md" />
        <None Include="Assets/LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
    </ItemGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
        <UseWindowsForms>true</UseWindowsForms>
        <DefineConstants>WINDOWS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
        <DefineConstants>ANDROID</DefineConstants>
        <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
        <PackageReference Include="Microsoft.Web.WebView2" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
        <!-- Required for AndroidViewControlHandle native embedding. -->
        <PackageReference Include="Avalonia.Android" />
    </ItemGroup>

</Project>